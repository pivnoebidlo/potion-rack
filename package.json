{
  "name": "potion-rack",
  "productName": "Potion Rack",
  "version": "0.10.0",
  "description": "A paint rack and project journal for miniature painters",
  "license": "GPL-3.0-or-later",
  "author": "pivnoebidlo <dima@niktokro.me>",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "import-legacy": "node --no-warnings scripts/import-legacy.ts",
    "postinstall": "node node_modules/electron/install.js",
    "dist": "electron-vite build && electron-builder",
    "build-catalog": "node --no-warnings scripts/build-catalog.ts"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@lucide/svelte": "^1.55.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/node": "^26.6.5",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "fflate": "^0.8.3",
    "marked": "^18.2.0",
    "spectral.js": "^3.0.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "uqr": "^0.1.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
