{
  "name": "potion-rack-mobile",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "description": "Potion Rack for Android: a copy of the rack that syncs with the desktop over Wi-Fi",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "sync": "vite build && cap sync android",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@capacitor-mlkit/barcode-scanning": "^8.2.2",
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/device": "^8.0.3",
    "@capacitor/preferences": "^8.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@lucide/svelte": "^1.55.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^7.3.7"
  }
}
